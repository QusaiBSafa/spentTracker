# Postgres connection strings. On Vercel these are set for you when you
# connect a Neon database; locally both can point at the same database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spent"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/spent"
# Any long random string; used to sign the login session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
