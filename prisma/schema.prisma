generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by migrations. Vercel's Neon
  // integration sets both; locally they can be the same URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  categories   Category[]
  expenses     Expense[]
  targets      MonthlyTarget[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Stored in minor units (agorot / cents) to avoid float rounding.
  amountMinor Int
  currency    String // "ILS" | "USD"
  // Calendar day as YYYY-MM-DD so a spend never shifts days across time zones.
  date        String
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

// Spending target for one month, always in ILS.
model MonthlyTarget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String // "YYYY-MM"
  amountMinor Int
  updatedAt   DateTime @updatedAt

  @@unique([userId, month])
}
